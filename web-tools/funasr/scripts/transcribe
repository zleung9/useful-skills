#!/bin/bash
# FunASR transcription CLI wrapper
# Activates venv (if exists) and runs the Python transcriber

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SKILL_DIR="$(dirname "$SCRIPT_DIR")"

# Resolve the Python interpreter: current venv > skill-local venv > legacy paths > system python3
if [[ -n "${VIRTUAL_ENV:-}" ]]; then
    PYTHON="python3"
else
    for candidate in \
        "$SKILL_DIR/venv/bin/python3" \
        "$SKILL_DIR/.venv/bin/python3" \
        "${HOME}/.agents/skills/funasr/venv/bin/python3" \
        "${HOME}/.agents/skills/funasr/.venv/bin/python3"; do
        if [[ -x "$candidate" ]]; then
            PYTHON="$candidate"
            break
        fi
    done
    : "${PYTHON:=python3}"
fi

# Run the transcriber
exec "$PYTHON" "${SCRIPT_DIR}/transcribe.py" "$@"
